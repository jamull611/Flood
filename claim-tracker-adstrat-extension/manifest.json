{
  "manifest_version": 3,
  "name": "Claim Tracker - AdStrat Sync",
  "version": "1.2.0",
  "description": "Lets your Adjuster Claim Tracker read your AdStrat claim list while you're signed in to AdStrat, by hand or automatically every 30 minutes. Read-only; never changes anything in AdStrat.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_icon": { "16": "icon16.png", "48": "icon48.png" }, "default_title": "Claim Tracker - AdStrat Sync" },
  "host_permissions": ["https://cms.adminstrat.com/*", "https://jamull611.github.io/Flood/*"],
  "permissions": ["scripting", "alarms", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "file:///*claim-tracker*.html",
        "https://jamull611.github.io/Flood/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
